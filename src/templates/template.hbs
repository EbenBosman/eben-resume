<html>

  <head>
    <meta charset='utf-8' />
    <style>
      /*
        ATS-SAFE SINGLE-COLUMN RESUME TEMPLATE.
        Do NOT reintroduce: multi-column/sidebar layouts, layout tables,
        images/icons as content, skill "pills", or sub-10px fonts.
        These break ATS parsers (e.g. Lever silently drops sidebars).
        Restrained creative flair only: one accent color + a monospace
        "typewriter" accent on headings (still real, parseable text).
      */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Helvetica, Arial, sans-serif;
      }

      body {
        color: #1f2937;
        font-size: 10.5px;
        line-height: 1.42;
        background: #ffffff;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* Print margins must be @page margins (mirrored by the PDF route's
         page.pdf `margin` option), NOT container padding — padding only
         applies at the document's start/end, leaving text flush against
         the paper edge on every page break. */
      @page {
        size: letter;
        margin: 0.5in 0.55in;
      }

      .page-container {
        padding: 0;
      }

      /* Header */
      .name {
        font-family: 'Courier New', Courier, monospace;
        font-size: 25px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #111827;
      }

      .title {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #2158b0;
        margin-top: 3px;
      }

      .contact {
        margin-top: 7px;
        font-size: 10px;
        color: #374151;
      }

      .contact a {
        color: #374151;
        text-decoration: none;
      }

      /* Sections */
      .section-title {
        font-family: 'Courier New', Courier, monospace;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #2158b0;
        border-bottom: 1.5px solid #2158b0;
        padding-bottom: 3px;
        margin: 16px 0 8px;
      }

      .summary p {
        margin-bottom: 5px;
        text-align: justify;
      }

      /* Skills */
      .skill-line {
        margin-bottom: 4px;
      }

      .skill-label {
        font-weight: 700;
        color: #111827;
      }

      /* Experience / Projects */
      .job {
        margin-bottom: 10px;
        page-break-inside: avoid;
      }

      .job-role {
        font-weight: 700;
        font-size: 11.5px;
        color: #111827;
      }

      .job-company {
        font-weight: 700;
        color: #2158b0;
      }

      .meta {
        font-size: 9.5px;
        color: #6b7280;
        margin: 1px 0 3px;
      }

      .job-summary {
        margin-bottom: 3px;
        text-align: justify;
      }

      ul.bullets {
        padding-left: 16px;
        list-style-type: disc;
      }

      ul.bullets li {
        margin-bottom: 2px;
        color: #374151;
      }

      /* Education */
      .edu {
        margin-bottom: 5px;
      }

      .edu-degree {
        font-weight: 700;
        color: #111827;
      }

      .edu-cred {
        color: #6b7280;
      }
    </style>
  </head>

  <body>
    <div class='page-container'>

      <!-- HEADER -->
      <div class='name'>{{basics.name}}</div>
      <div class='title'>{{basics.position}}</div>
      <div class='contact'>
        {{basics.location}}
        |
        {{basics.phone}}
        |
        <a href='mailto:{{basics.business_email}}'>{{basics.business_email}}</a>
        |
        <a href='https://{{basics.website}}'>{{basics.website}}</a>
        |
        <a href='{{basics.social.linkedIn}}'>{{#replace
            basics.social.linkedIn 'https://' ''
          }}{{/replace}}</a>
        |
        <a href='{{basics.social.github}}'>{{#replace
            basics.social.github 'https://' ''
          }}{{/replace}}</a>
      </div>

      <!-- PROFESSIONAL SUMMARY -->
      <div class='section-title'>Professional Summary</div>
      <div class='summary'>
        {{#each about}}
          <p>{{this}}</p>
        {{/each}}
      </div>

      <!-- SKILLS -->
      <div class='section-title'>Skills</div>
      <div class='skills'>
        {{#each skills}}
          <div class='skill-line'>
            <span class='skill-label'>{{this.Title}}:</span>
            {{#each this.Items}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
          </div>
        {{/each}}
      </div>

      <!-- EXPERIENCE -->
      <div class='section-title'>Experience</div>
      {{#each work}}
        <div class='job'>
          <div class='job-role'>{{this.position}},
            <span class='job-company'>{{this.company}}</span></div>
          <div class='meta'>{{this.location}}
            |
            {{this.startDate}}
            -
            {{this.endDate}}</div>
          {{#if this.summary}}
            <div class='job-summary'>{{this.summary}}</div>
          {{/if}}
          {{#if this.highlights}}
            <ul class='bullets'>
              {{#each this.highlights}}
                <li>{{this}}</li>
              {{/each}}
            </ul>
          {{/if}}
        </div>
      {{/each}}

      <!-- PROJECTS -->
      <div class='section-title'>Projects</div>
      <div class='job'>
        <div class='job-role'>{{ataru.name}}
          ({{ataru.subtitle}}),
          <span class='job-company'>{{#replace ataru.url 'https://' ''}}{{/replace}}</span></div>
        <div class='meta'>{{ataru.tagline}}</div>
        {{#each ataru.summary}}
          <div class='job-summary'>{{this}}</div>
        {{/each}}
        <div class='job-summary'><span class='skill-label'>Features:</span>
          {{#each ataru.features}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</div>
      </div>

      <!-- EDUCATION & CERTIFICATIONS -->
      <div class='section-title'>Education &amp; Certifications</div>
      {{#each education}}
        <div class='edu'>
          <span class='edu-degree'>{{this.what}}</span>,
          {{this.where}}{{#if this.when}}
            ({{this.when}}){{/if}}{{#if this.credentialId}}
            <span class='edu-cred'>| Credential ID: {{this.credentialId}}</span>{{/if}}
        </div>
      {{/each}}

      <!-- REFERENCES -->
      <div class='section-title'>References</div>
      <div class='job-summary'>Available upon request.</div>

    </div>
  </body>

</html>