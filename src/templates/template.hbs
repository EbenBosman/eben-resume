<html>

  <head>
    <meta charset='utf-8' />
    <title>{{basics.name}} - Resume</title>
    <style>
      /*
        ATS-SAFE SINGLE-COLUMN RESUME TEMPLATE, styled with the Cesium 455
        design system (ataru.io), always light.
        Do NOT reintroduce: multi-column/sidebar layouts, layout tables,
        images/icons as content, skill "pills", sub-10px fonts, or text added
        by CSS (::before/::after content lands in the PDF text layer).
        Keep ligatures off and letter-spacing tiny: fi/fl ligatures turn
        "Certified" into "Certiﬁed" in the text layer, and wide letter-spacing
        makes layout parsers read headings as "E X P E R I E N C E".
        Fonts (Ubuntu + Electrolize) are embedded as @font-face data URLs by
        src/lib/resume-html.ts (inserted at the top of this <style>);
        Helvetica/Arial are only a fallback.
      */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Ubuntu', Helvetica, Arial, sans-serif;
        font-variant-ligatures: none;
        font-feature-settings:
          'liga' 0,
          'clig' 0;
      }

      body {
        color: #1f2937;
        font-size: 11px;
        line-height: 1.45;
        background: #ffffff;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* Print margins must be @page margins (mirrored by the PDF route's
                     page.pdf `margin` option), NOT container padding — padding only
                     applies at the document's start/end, leaving text flush against
                     the paper edge on every page break. */
      @page {
        size: letter;
        margin: 0.5in 0.55in;
      }

      .page-container {
        padding: 0;
      }

      /* Header: Ubuntu display name, Electrolize submark in Cesium 455 */
      .name {
        font-size: 26px;
        font-weight: 700;
        letter-spacing: -0.3px;
        line-height: 1.1;
        color: #111827;
      }

      .title {
        font-family: 'Electrolize', 'Ubuntu', sans-serif;
        font-size: 12.5px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #004cff;
        margin-top: 4px;
      }

      .contact {
        margin-top: 8px;
        padding-top: 7px;
        border-top: 1px solid #e5e7eb;
        font-size: 10px;
        color: #4b5563;
      }

      .contact a {
        color: #4b5563;
        text-decoration: none;
      }

      /* Sections: Electrolize label on a hairline Cesium rule */
      .section-title {
        font-family: 'Electrolize', 'Ubuntu', sans-serif;
        font-size: 12px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #004cff;
        border-bottom: 1px solid #004cff;
        padding-bottom: 3px;
        margin: 15px 0 8px;
      }

      .summary p {
        margin-bottom: 5px;
        text-align: left;
      }

      /* Horizontal lists (contact, skills, features) may only wrap BETWEEN items, never inside
         one (e.g. "Local LLMs (Ollama, LM / Studio)"). Text and separators are unchanged. */
      .nb {
        white-space: nowrap;
      }

      /* Skills */
      .skill-line {
        margin-bottom: 3px;
      }

      .skill-label {
        font-weight: 700;
        color: #111827;
      }

      /* Experience / Projects */
      .job {
        margin-bottom: 10px;
        page-break-inside: avoid;
      }

      .job-role {
        font-weight: 700;
        font-size: 11.5px;
        color: #111827;
      }

      .job-company {
        font-weight: 700;
        color: #0033b8;
      }

      .meta {
        font-family: 'Electrolize', 'Ubuntu', sans-serif;
        font-size: 10px;
        color: #6b7280;
        margin: 1px 0 3px;
      }

      .job-summary {
        margin-bottom: 3px;
        text-align: left;
      }

      ul.bullets {
        padding-left: 15px;
        list-style-type: square;
      }

      ul.bullets li {
        margin-bottom: 2px;
        color: #374151;
      }

      ul.bullets li::marker {
        color: #004cff;
      }

      /* Education */
      .edu {
        margin-bottom: 5px;
      }

      .edu-degree {
        font-weight: 700;
        color: #111827;
      }

      .edu-cred {
        color: #6b7280;
      }
    </style>
  </head>

  <body>
    <div class='page-container'>

      <!-- HEADER -->
      <div class='name'>{{basics.name}}</div>
      <div class='title'>{{basics.position}}</div>
      <div class='contact'>
        <span class='nb'>{{basics.location}}</span>
        |
        <span class='nb'>{{basics.phone}}</span>
        |
        <a class='nb' href='mailto:{{basics.business_email}}'>{{basics.business_email}}</a>
        |
        <a class='nb' href='https://{{basics.website}}'>{{basics.website}}</a>
        |
        <a class='nb' href='{{basics.social.linkedIn}}'>{{#replace
            basics.social.linkedIn 'https://' ''
          }}{{/replace}}</a>
        |
        <a class='nb' href='{{basics.social.github}}'>{{#replace
            basics.social.github 'https://' ''
          }}{{/replace}}</a>
      </div>

      <!-- PROFESSIONAL SUMMARY -->
      <div class='section-title'>Professional Summary</div>
      <div class='summary'>
        {{#each about}}
          <p>{{this}}</p>
        {{/each}}
      </div>

      <!-- SKILLS -->
      <div class='section-title'>Skills</div>
      <div class='skills'>
        {{#each skills}}
          <div class='skill-line'>
            <span class='skill-label'>{{this.Title}}:</span>
            {{#each this.Items}}<span class='nb'>{{this}}</span>{{#unless @last}},
              {{/unless}}{{/each}}
          </div>
        {{/each}}
      </div>

      <!-- EXPERIENCE -->
      <div class='section-title'>Experience</div>
      {{#each work}}
        <div class='job'>
          <div class='job-role'>{{this.position}},
            <span class='job-company'>{{this.company}}</span></div>
          <div class='meta'>{{this.location}}
            |
            {{this.startDate}}
            -
            {{this.endDate}}</div>
          {{#if this.summary}}
            <div class='job-summary'>{{this.summary}}</div>
          {{/if}}
          {{#if this.highlights}}
            <ul class='bullets'>
              {{#each this.highlights}}
                <li>{{this}}</li>
              {{/each}}
            </ul>
          {{/if}}
        </div>
      {{/each}}

      <!-- PROJECTS -->
      <div class='section-title'>Projects</div>
      <div class='job'>
        <div class='job-role'>{{ataru.name}}
          ({{ataru.subtitle}}),
          <span class='job-company'>{{#replace ataru.url 'https://' ''}}{{/replace}}</span></div>
        <div class='meta'>{{ataru.tagline}}</div>
        {{#each ataru.summary}}
          <div class='job-summary'>{{this}}</div>
        {{/each}}
        <div class='job-summary'><span class='skill-label'>Features:</span>
          {{#each ataru.features}}<span class='nb'>{{this}}</span>{{#unless @last}},
            {{/unless}}{{/each}}</div>
      </div>

      <!-- EDUCATION & CERTIFICATIONS -->
      <div class='section-title'>Education &amp; Certifications</div>
      {{#each education}}
        <div class='edu'>
          <span class='edu-degree'>{{this.what}}</span>,
          {{this.where}}{{#if this.when}}
            ({{this.when}}){{/if}}{{#if this.credentialId}}
            <span class='edu-cred'>| Credential ID: {{this.credentialId}}</span>{{/if}}
        </div>
      {{/each}}

      <!-- REFERENCES -->
      <div class='section-title'>References</div>
      <div class='job-summary'>Available upon request.</div>

    </div>
  </body>

</html>