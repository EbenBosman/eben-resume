<html>

  <head>
    <meta charset='utf-8' />
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap');

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Roboto', sans-serif;
      }

      body {
        background: linear-gradient(to right, #111827 0%, #111827 30%, #ffffff 30%, #ffffff 100%);
        color: #374151;
        /* gray-700 */
        font-size: 9px;
        line-height: 1.4;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* Layout */
      .page-container {
        display: flex;
        flex-direction: row;
        width: 100%;
        min-height: 100vh;
      }

      /* LEFT SIDEBAR */
      .sidebar {
        width: 30%;
        color: #ffffff;
        /* Safe Zone: Increased Top/Bottom padding to 25px */
        padding: 25px 20px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        /* Reduced gap to compensate */
      }

      .sidebar h3 {
        color: #60a5fa;
        /* blue-400 - lighter for dark bg */
        font-size: 11px;
        /* Reduced size */
        text-transform: uppercase;
        border-bottom: 1px solid #374151;
        padding-bottom: 5px;
        margin-bottom: 6px;
        /* Reduced */
        letter-spacing: 1px;
      }

      .contact-item {
        margin-bottom: 5px;
        /* Reduced */
        font-size: 8.5px;
        word-wrap: break-word;
      }

      .contact-item a {
        color: #d1d5db;
        /* gray-300 */
        text-decoration: none;
      }

      .skill-group {
        margin-bottom: 8px;
        /* Reduced margin */
      }

      .skill-title {
        font-weight: 700;
        font-size: 10px;
        margin-bottom: 4px;
        color: #e5e7eb;
        /* gray-200 */
      }

      .skill-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
      }

      .pill {
        background-color: #374151;
        /* gray-700 */
        color: #ffffff;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 8px;
      }

      .edu-item {
        margin-bottom: 8px;
        /* Reduced margin */
      }

      .edu-degree {
        font-weight: 700;
        font-size: 10px;
      }

      .edu-meta {
        font-style: italic;
        color: #9ca3af;
        /* gray-400 */
        font-size: 9px;
      }

      /* Ataru Section */
      .ataru-summary p {
        font-size: 8.5px;
        color: #d1d5db;
        /* gray-300 */
        line-height: 1.35;
        margin-bottom: 2px;
        text-align: justify;
      }

      /* RIGHT MAIN CONTENT */
      .main {
        width: 70%;
        /* Safe Zone: Increased Top/Bottom padding to 25px */
        padding: 25px 30px;
      }

      .header {
        margin-bottom: 10px;
        /* Reduced */
        padding-bottom: 8px;
        /* Reduced padding */
      }

      .header h1 {
        font-size: 28px;
        /* Reduced size */
        font-weight: 700;
        color: #111827;
        margin-bottom: 5px;
        line-height: 1;
      }

      .header h2 {
        font-size: 14px;
        font-weight: 400;
        color: #2158b0;
        /* primary */
        text-transform: uppercase;
        letter-spacing: 2px;
      }

      .section {
        margin-bottom: 10px;
        /* Reduced */
      }

      .section-title {
        font-size: 12px;
        /* Reduced size */
        font-weight: 700;
        color: #2158b0;
        text-transform: uppercase;
        border-bottom: 1px solid #e5e7eb;
        padding-bottom: 5px;
        margin-bottom: 8px;
        /* Reduced margin */
      }

      .about-text p {
        margin-bottom: 5px;
        text-align: justify;
        font-size: 9px;
        line-height: 1.45;
      }

      .job-item {
        margin-bottom: 6px;
        /* Reduced */
        page-break-inside: avoid;
      }

      .job-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 2px;
      }

      .job-role {
        font-weight: 700;
        font-size: 10px;
        color: #111827;
      }

      .job-company {
        color: #2158b0;
        font-weight: 500;
      }

      .job-meta {
        font-size: 8.5px;
        /* Slightly smaller meta */
        color: #6b7280;
        /* gray-500 */
        margin-bottom: 4px;
        font-style: italic;
      }

      .job-summary {
        margin-bottom: 4px;
        text-align: justify;
        line-height: 1.4;
      }

      .job-highlights {
        padding-left: 12px;
        list-style-type: disc;
      }

      .job-highlights li {
        margin-bottom: 1px;
        color: #4b5563;
        line-height: 1.4;
      }

      a {
        color: inherit;
        text-decoration: none;
      }
    </style>
  </head>

  <body>
    <div class='page-container'>
      <!-- LEFT SIDEBAR -->
      <div class='sidebar'>
        <!-- Contact -->
        <div>
          <h3>Contact</h3>
          <div class='contact-item'>
            <strong>Phone</strong><br />
            {{basics.phone}}
          </div>
          <div class='contact-item'>
            <strong>Personal Email</strong><br />
            <a href='mailto:{{basics.persona_email}}'>{{basics.persona_email}}</a>
          </div>
          <div class='contact-item'>
            <strong>Business Email</strong><br />
            <a href='mailto:{{basics.business_email}}'>{{basics.business_email}}</a>
          </div>
          <div class='contact-item'>
            <strong>Location</strong><br />
            {{basics.location}}
          </div>
          <div class='contact-item'>
            <strong>Website</strong><br />
            <a href='https://{{basics.website}}'>{{basics.website}}</a>
          </div>
        </div>

        <!-- Ataru -->
        <div>
          <h3 style='display: flex; align-items: center; gap: 6px;'>
            <img
              src='{{ataruLogoBase64}}'
              alt='Ataru'
              style='width: 18px; height: 18px; border-radius: 4px;'
            />
            {{ataru.name}}
          </h3>
          <div class='contact-item'>
            <strong><a href='{{ataru.url}}'>{{#replace
                  ataru.url 'https://' ''
                }}{{/replace}}</a></strong>
          </div>
          <div class='ataru-summary'>
            {{#each ataru.summary}}
              <p>{{this}}</p>
            {{/each}}
          </div>
        </div>

        <!-- Links -->
        <div>
          <h3>Links</h3>
          <div class='contact-item'>
            <strong>GitHub</strong><br />
            <a href='{{basics.social.github}}'>{{#replace
                basics.social.github 'https://' ''
              }}{{/replace}}</a>
          </div>
          <div class='contact-item'>
            <strong>LinkedIn</strong><br />
            <a href='{{basics.social.linkedIn}}'>{{#replace
                basics.social.linkedIn 'https://' ''
              }}{{/replace}}</a>
          </div>
          <div class='contact-item'>
            <strong>Stack Overflow</strong><br />
            <a href='{{basics.social.stackOverflow}}'>{{#replace
                basics.social.stackOverflow 'https://' ''
              }}{{/replace}}</a>
          </div>
        </div>

        <!-- Skills -->
        <div>
          <h3>Skills</h3>
          {{#each skills}}
            <div class='skill-group'>
              <div class='skill-title'>{{this.Title}}</div>
              <div class='skill-pills'>
                {{#each this.Items}}
                  <span class='pill'>{{this}}</span>
                {{/each}}
              </div>
            </div>
          {{/each}}
        </div>

        <!-- Education -->
        <div>
          <h3>Education</h3>
          {{#each education}}
            <div class='edu-item'>
              <div class='edu-degree'>{{this.what}}</div>
              <div class='edu-meta'>{{this.where}} • {{this.when}}</div>
            </div>
          {{/each}}
        </div>

        <!-- References -->
        {{!--
			<div>
				<h3>References</h3>
				{{#each references}}
				<div class="contact-item">
					<strong>{{this.name}}</strong><br>
					{{this.reference}}
				</div>
				{{/each}}
			</div>
			--}}
        <div>
          <h3>References</h3>
          <div class='contact-item'>
            <strong>Available upon request</strong><br />
            Please contact me directly to request references.
          </div>
        </div>
      </div>

      <!-- RIGHT MAIN CONTENT -->
      <div class='main'>
        <div class='header'>
          <h1>{{basics.name}}</h1>
          <h2>{{basics.position}}</h2>
          <!-- Using position here instead of label for clearer role title -->
        </div>

        <!-- About -->
        <div class='section'>
          <div class='section-title'>About Me</div>
          <div class='about-text'>
            {{#each about}}
              <p>{{this}}</p>
            {{/each}}
          </div>
        </div>

        <!-- Experience -->
        <div class='section'>
          <div class='section-title'>Experience</div>
          {{#each work}}
            <div class='job-item'>
              <div class='job-header'>
                <div>
                  <span class='job-role'>{{this.position}}</span>
                  <span style='font-size: 10px; color: #9ca3af;'> at </span>
                  <span class='job-company'><a href='{{this.website}}'>{{this.company}}</a></span>
                </div>
                <div class='job-meta'>{{this.startDate}} - {{this.endDate}}</div>
              </div>
              <div class='job-meta'>{{this.location}}</div>

              {{#if this.summary}}
                <div class='job-summary'>{{this.summary}}</div>
              {{/if}}

              {{#if this.highlights}}
                <ul class='job-highlights'>
                  {{#each this.highlights}}
                    <li>{{this}}</li>
                  {{/each}}
                </ul>
              {{/if}}
            </div>
          {{/each}}
        </div>
      </div>
    </div>
  </body>

</html>